# Copy to .env. Everything here is read by the orchestrator only. The browser
# never receives an AssemblyAI key: it talks to the orchestrator, and the
# orchestrator talks to AssemblyAI.

# The shared demo key. Optional: without it, every call must bring its own key
# from the setup page.
ASSEMBLYAI_API_KEY=

# Optional. Leave blank to discover the smallest model this key can use via
# GET https://llm-gateway.assemblyai.com/v1/models
LLM_GATEWAY_MODEL=

# The orchestrator's own public HTTPS address. The Voice Agent calls
# PUBLIC_URL/llm/v1 for what to say, so it must be reachable from the internet.
# Leave blank on a laptop: a Cloudflare quick tunnel is opened automatically.
PUBLIC_URL=

# Where the website is served from, comma separated. WebSocket and CORS checks.
ALLOWED_ORIGINS=http://localhost:3000

PORT=8787

# Protecting a shared key on a public demo. Calls on a visitor's own key are
# limited only by MAX_TOTAL_CALLS.
MAX_SERVER_CALLS=2
MAX_TOTAL_CALLS=8
CALLS_PER_IP_PER_HOUR=8
MAX_CALL_SECONDS=180
API_PER_IP_PER_MINUTE=20
