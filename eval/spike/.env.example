# Copy this file to .env and paste your key in.
# Get it from https://www.assemblyai.com/app/api-keys
# Sign up through the hackathon link in Rules.md first, and accept cookies,
# or the free credits do not attach to the account.

ASSEMBLYAI_API_KEY=

# Optional. Only needed for test 05, the Dissent latency check.
# If your AssemblyAI account has LLM Gateway access, leave this blank and
# test 05 will use the AssemblyAI gateway with the key above.
# Set this only if you want to compare against a direct provider.
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_MODEL=
